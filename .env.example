PAYDESK_MODEL=claude-opus-5-5
USD_INR=84
# RazorpayX TEST mode only (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Trust & Compliance service (else data/vendors.json)
TRUST_API_URL=
PAYDESK_COST_LIMIT=10
PAYDESK_TIME_LIMIT=600
# seconds to sleep between steps (kill-on-stage demo)
PAYDESK_STEP_DELAY=0
